{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "rsbuild dev -c rsbuild.config.ts",
    "dev:admin": "rsbuild dev -c rsbuild.admin.config.ts",
    "build:miniapp": "rsbuild build -c rsbuild.config.ts",
    "build:admin": "rsbuild build -c rsbuild.admin.config.ts",
    "build": "tsc -b && npm run build:miniapp && npm run build:admin",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "rsbuild preview -c rsbuild.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
